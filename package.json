{
  "name": "bighouse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:frontend && wrangler dev",
    "dev:frontend": "pnpm --filter @bighouse/frontend dev",
    "build:frontend": "pnpm --filter @bighouse/frontend build",
    "build": "pnpm build:frontend",
    "deploy": "pnpm build:frontend && wrangler deploy",
    "typecheck": "tsc --noEmit && pnpm --filter @bighouse/game-sdk typecheck && pnpm --filter @bighouse/ui typecheck && pnpm --filter @bighouse/chess typecheck && pnpm --filter @bighouse/gomoku typecheck && pnpm --filter @bighouse/onecard typecheck && pnpm --filter @bighouse/tank-battle typecheck && pnpm --filter @bighouse/frontend typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@bighouse/chess": "workspace:*",
    "@bighouse/game-sdk": "workspace:*",
    "@bighouse/gomoku": "workspace:*",
    "@bighouse/onecard": "workspace:*",
    "@bighouse/tank-battle": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.6",
    "@cloudflare/workers-types": "^4.20260510.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.16.1"
  }
}
