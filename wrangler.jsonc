{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bighouse",
  "main": "src/index.ts",
  "assets": {
    "directory": "./packages/frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/games", "/games/*", "/rooms/*", "/matchmaking/*"]
  },
  "compatibility_date": "2026-05-18",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "LOBBY_DO", "class_name": "LobbyDO" },
      { "name": "MATCHMAKER_DO", "class_name": "MatchmakerDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "LobbyDO", "MatchmakerDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bighouse",
      "database_id": "480432b2-1493-44f7-b168-b9d79a371854"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  }
}
